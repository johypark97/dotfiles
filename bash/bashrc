#!/usr/bin/env bash

# If not running interactively, don't do anything
case $- in
    *i*) ;;
    *) return ;;
esac

main()
{
    local -r SCRIPT_ROOT=$( dirname "$( realpath "${BASH_SOURCE[0]}" )" )

    local dotfiles_root
    dotfiles_root=$( dirname "$SCRIPT_ROOT" )
    export DOTFILES_ROOT=$dotfiles_root

    source "$SCRIPT_ROOT/script/function.sh"
    source "$SCRIPT_ROOT/script/prompt.sh"
    source "$SCRIPT_ROOT/script/config.sh"
    source "$SCRIPT_ROOT/script/alias.sh"
}

main
unset -f main
